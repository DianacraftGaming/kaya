{
	"schemaVersion": 1,
	"id": "kaya",
	"version": "${version}",
	"name": "Kaya",
	"description": "Empower your game with Kaya, a library for adding data-driven powers to entities.",
	"authors": [
		"eggohito"
	],
	"contact": {
		"sources": "https://github.com/eggomods/kaya",
		"issues": "https://github.com/eggomods/kaya/issues"
	},
	"license": "MIT",
	"icon": "assets/kaya/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.eggohito.kaya.Kaya"
		],
		"client": [
			"io.github.eggohito.kaya.KayaClient"
		],
		"modmenu": [
			"io.github.eggohito.kaya.client.integration.ModMenuIntegration"
		]
	},
	"mixins": [
		"kaya.mixins.json",
		{
			"environment": "client",
			"config": "kaya.mixins.client.json"
		}
	],
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": ">=${fabric}",
		"yet_another_config_lib_v3": ">=${yacl}"
	},
	"suggests": {
		"modmenu": ">={modmenu}"
	},
	"accessWidener": "kaya.classtweaker"
}
